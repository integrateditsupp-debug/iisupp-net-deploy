}

.header-nav-bar.header-colored .main-nav.ui.secondary.inverted.button-style.menu > .item > .ui.button.button:focus {
	background-color: #003366 !important;
	box-shadow: inset 0px 0px 0px 2px rgba(205, 214, 226,1);
}

.header-nav-bar.header-colored .main-nav.ui.secondary.inverted.button-style.menu > .item.selected-menu > .ui.button.button:focus {
	background-color: #fff !important;
	color: #003366 !important;
	box-shadow: inset 0px 0px 0px 2px rgba(205, 214, 226,1);
}

/* make the menu dropdown hover color orange */
.main-nav.ui.menu.main .main-nav.ui.dropdown.selected-menu .main-nav.menu .item.selected-item > a,
.main-nav.ui.menu.main .main-nav.ui.dropdown .main-nav.menu .item > a:hover,
.main-nav.ui.menu.main .main-nav.ui.dropdown.selected-menu .main-nav.menu .item > a:hover,
.main-nav.ui.menu.main .main-nav.ui.dropdown .main-nav.menu .item .item.submenu > a:hover,
.main-nav.ui.menu.main .main-nav.ui.dropdown .main-nav.menu .item .item.submenu.selected-item a {
	background-color: #E98300 !important;
	color: #fff !Important;
}

.main-nav.ui.menu.main .main-nav.ui.dropdown .main-nav.menu .item .item.submenu .icon {
	pointer-events: none;
}

