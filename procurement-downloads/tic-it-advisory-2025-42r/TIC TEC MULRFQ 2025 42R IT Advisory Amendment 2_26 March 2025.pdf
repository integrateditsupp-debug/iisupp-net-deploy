}
 
    /*make default checkbox not-visible*/
    body.print-mode .checkbox-control input[type="checkbox"],
	.checkbox-control input[type="checkbox"] {
        opacity: 0 !important;
    }
    
    body.print-mode .checkbox-control input[type="checkbox"] label,

	.checkbox-control input[type="checkbox"] label {
        position: relative !important;
        display: inline-block !important;
        /*16px width of fake checkbox + 6px distance between fake checkbox and text*/
        padding-left: 22px !important;
        /*border-color: #606060 !important;*/
		border-color: #D4D4D5 !important
    }
	
	body.print-mode .checkbox-control input[type="checkbox"] label
	{
		padding-left:22px !important;
	}
    
    /* control positioning for checkbox */
	body.print-mode .checkbox-control input[type="checkbox"]+label::before,
	body.print-mode .checkbox-control input[type="checkbox"]+label::after,
    .checkbox-control input[type="checkbox"] label::before,
    .checkbox-control input[type="checkbox"] label::after {
        position: absolute !Important;
        content: "";
        /*Needed for the line-height to take effect*/
        display: inline-block !important;
    }

    /*Outer box of the fake checkbox*/
	body.print-mode .checkbox-control input[type="checkbox"]+label::before,
    .checkbox-control input[type="checkbox"] label::before {
        height: 16px !important;
        width: 16px !important;
        border: 1px solid #D4D4D5 !important;
        left: 0px !important;
        /*((24px line-height - 16px height of fake checkbox) / 2 )- 1px for the border
        *to vertically center it. */
        top: 3px !important;
        color: #333 !important;
    }

	body.print-mode .checkbox-control input[type="checkbox"]+label::before {
		top: 0 !important;
	}

    body.light.print-mode ui.checkbox input:checked~.box:before,
    body.light.print-mode ui.checkbox input:checked~label:before,
    body.light.print-mode .ui.checkbox label:before,
    body.light .ui.checkbox input:checked~.box:before, 
    body.light .ui.checkbox input:checked~label:before, 
    body.light .ui.checkbox label:before,
	body.accessibility.print-mode ui.checkbox input:checked~.box:before,
    body.accessibility.print-mode ui.checkbox input:checked~label:before,
    body.accessibility.print-mode .ui.checkbox label:before,
    body.accessibility .ui.checkbox input:checked~.box:before, 
    body.accessibility .ui.checkbox input:checked~label:before, 
    body.accessibility .ui.checkbox label:before {
        color: #606060 !important;
    }

	/*Checkmark of the fake checkbox*/
	body.print-mode .checkbox-control input[type="checkbox"]>label::after,
    .checkbox-control input[type="checkbox"] label::after {
        height: 5px !important;
        width: 9px !important;
		color: #606060 !important;
		content: "\2713" !important;
        left: 4px !important;
        top: 7px !important;
		font-weight: 400;
    }
	
    body.print-mode .ui.checkbox input:checked~.box:after,
    body.print-mode .ui.checkbox input:checked~label:after,
	.ui.checkbox input:checked~.box:after, 
    .ui.checkbox input:checked~label:after {
        content: '\2713' !important;
        /*color: #606060 !important;*/
    }
	
   body.print-mode .ui.checkbox input:checked~.box:after,
   body.print-mode .ui.checkbox input:checked~label:after
   {
       content: '\2713' !important;
       border: 0
       /*transform: rotate(-45deg) !important*/
   }
    
	/*Color of the readonly/disabled checkmark */
    body.print-mode .checkbox-control input[type="checkbox"][disabled]+label::after,
    body.print-mode .checkbox-control input[type="checkbox"][readonly]+label::after,
    .checkbox-control input[type="checkbox"][disabled]+label::after,
    .checkbox-control input[type="checkbox"][readonly]+label::after {
    content: "\2713" !important;
    color: #333 !important;
    font-weight: 1000;
    }
    
    
	/*Adding focus styles on the outer-box of the fake checkbox*/
	body.print-mode .checkbox-control input[type="checkbox"]:focus+label::before,
    .checkbox-control input[type="checkbox"]:focus+label::before {
        outline: #606060 auto 5px !Important;
    }

	/*Prevent usage of readonly/disabled checkbox */
    body.print-mode .checkbox-control input[type=checkbox][readonly] label,
    body.print-mode .checkbox-control input[type=checkbox][disabled] label,
    .checkbox-control input[type=checkbox][readonly]+label,
    .checkbox-control input[type=checkbox][disabled]+label {
        pointer-events: none !important; 
        border-color: #D4D4D5 !important;
    }
   
	/*fill in disabled/readonly checkbox background*/
    body.print-mode .ui.form div.field.readonly .checkbox label:before, 
    body.print-mode .ui.form div.field.readonly .checkbox label:hover:before, 
    body.print-mode .ui.form div.fields.readonly .checkbox label:before, 
    body.print-mode .ui.form div.fields.readonly .checkbox label:hover:before, 
    body.print-mode .checkbox-control input[type='checkbox'][readonly]+label::before, 
    body.print-mode .checkbox-control input[type='checkbox'][disabled]+label::before,
    .ui.form div.field.readonly .checkbox label:before, 
    .ui.form div.field.readonly .checkbox label:hover:before, 
    .ui.form div.fields.readonly .checkbox label:before, 
    .ui.form div.fields.readonly .checkbox label:hover:before, 
    .checkbox-control input[type=checkbox][readonly]+label::before, 
    .checkbox-control input[type=checkbox][disabled]+label::before {
        background-color: #C1C1C1 !important;
        border: 1px solid #333 !important;
    }

body.light div[data-iv-pageurl="/usr/login_terms"] .ui.checkbox label::before { border-color: #000 !important}
    
