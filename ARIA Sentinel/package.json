  "scripts": {
    "start": "electron .",
    "start:dry-run": "set ARIA_SENTINEL_DRY_RUN=1&& electron .",
    "test": "node tests/run-all.mjs",
    "audit": "node tests/privacy-audit.mjs",
    "scenario:test": "node tests/scenario-suite.mjs",
    "fetch:vosk-model": "node scripts/fetch-vosk-model.mjs",
