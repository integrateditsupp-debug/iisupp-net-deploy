    "package:win": "node scripts/package-win.mjs",
    "package:win:nsis": "node scripts/package-win.mjs --nsis-only",
    "package:win:verify": "node scripts/package-win.mjs --verify-only",
    "package:mac": "npm run fetch:vosk-model && electron-builder --mac --publish never",
    "package:dir": "npm run fetch:vosk-model && electron-builder --dir --publish never",
    "release:github": "node scripts/publish-github-release.mjs",
    "release:manifest": "node scripts/publish-manifest.mjs",
    "test:boot": "node tests/boot-smoke.mjs"
