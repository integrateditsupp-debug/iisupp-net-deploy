{
  "name": "aria-sentinel",
  "version": "0.1.16",
  "private": true,
  "description": "ARIA Sentinel Windows desktop agent and Chrome extension MVP.",
  "author": "Integrated IT Support Inc.",
  "type": "module",
  "main": "src/main/main.mjs",
  "scripts": {
    "start": "electron .",
    "start:dry-run": "set ARIA_SENTINEL_DRY_RUN=1&& electron .",
    "test": "node tests/run-all.mjs",
    "audit": "node tests/privacy-audit.mjs",
    "scenario:test": "node tests/scenario-suite.mjs",
    "fetch:vosk-model": "node scripts/fetch-vosk-model.mjs",
    "package:win": "npm run fetch:vosk-model && electron-builder --win nsis --publish never",
    "package:mac": "npm run fetch:vosk-model && electron-builder --mac --publish never",
    "package:dir": "npm run fetch:vosk-model && electron-builder --dir --publish never",
    "test:boot": "node tests/boot-smoke.mjs"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9",
    "vosk-browser": "^0.0.8"
  },
  "devDependencies": {
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "net.iisupp.aria-sentinel",
    "productName": "ARIA Sentinel",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "chrome-extension/**/*",
      "edge-extension/**/*",
      "aria-kb-pack/**/*",
      "package.json",
      "README-MVP.md",
      ".env.example"
    ],
    "extraResources": [
      "admin-console/**/*",
      {
        "from": "resources/models/vosk-model-small-en-us",
        "to": "vosk-model-small-en-us"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "ARIA-Sentinel-${version}-unsigned.${ext}",
      "signExecutable": false
    },
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dir"
      ],
      "artifactName": "ARIA-Sentinel-${version}-adhoc.${ext}",
      "identity": null,
      "hardenedRuntime": false,
      "type": "distribution"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
