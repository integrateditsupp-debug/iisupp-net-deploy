        "to": "vosk-model-small-en-us"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "msi"
      ],
      "artifactName": "ARIA-Sentinel-${version}-unsigned.${ext}",
      "signExecutable": false
    },
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dir"
      ],
      "artifactName": "ARIA-Sentinel-${version}-adhoc.${ext}",
      "identity": null,
      "hardenedRuntime": false,
      "type": "distribution"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "shortcutName": "ARIA Sentinel",
      "uninstallDisplayName": "ARIA Sentinel"
    },
    "msi": {
      "oneClick": false,
      "perMachine": true,
      "runAfterFinish": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "upgradeCode": "6404d180-7eb3-40bf-b230-a85ee5f32ebe",
      "warningsAsErrors": false
