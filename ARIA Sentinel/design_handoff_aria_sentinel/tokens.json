{
  "$meta": {
    "product": "ARIA Sentinel",
    "company": "Integrated IT Support Inc.",
    "mode": "dark-only",
    "note": "Gold on black, never inverted. Globe theme is gold-on-black regardless of OS theme."
  },
  "color": {
    "bg": "#050505",
    "surface": "#0a0a0a",
    "inset": "#141414",
    "border": "#2a2a2a",
    "borderSoft": "#1c1c1c",
    "borderFaint": "#1a1a1a",
    "gold": "#c5a059",
    "goldLight": "#f1dca7",
    "goldDark": "#8b6d2f",
    "goldKicker": "#7d6326",
    "goldTintBg": "#15110a",
    "goldTintBorder": "#38301d",
    "text": "#ffffff",
    "text2": "#aaaaaa",
    "textMuted": "#666666",
    "success": "#7afbff",
    "warning": "#ffcb6b",
    "error": "#ff7e7e"
  },
  "font": {
    "display": "Cinzel, serif",
    "ui": "Inter, system-ui, sans-serif",
    "mono": "ui-monospace, SF Mono, Monaco, Menlo, monospace"
  },
  "radius": { "sm": 5, "md": 8, "lg": 12, "xl": 14, "xxl": 18 },
  "gradient": {
    "gold": "linear-gradient(90deg,#c5a059,#f1dca7)",
    "card": "linear-gradient(180deg,#141414,#0a0a0a)"
  },
  "motion": {
    "cardSlideUp": { "duration": 260, "easing": "cubic-bezier(.16,1,.3,1)" },
    "cursorDodge": { "duration": 200, "easing": "linear" },
    "globePulse": { "duration": 4200, "easing": "ease-in-out", "opacity": [0.5, 0.92] },
    "globeRotation": { "idleSeconds": 34, "diagnosingMultiplier": 2, "fixingMultiplier": 4, "idleFpsDrop": 30 }
  },
  "footprint": {
    "globeDefaultPx": 64,
    "globeActivePx": 96,
    "globeHitboxPx": 80,
    "globeClickThrough": true,
    "overlayMaxWidthPx": 320,
    "overlayMaxHeightPx": 200
  }
}
