  "router_policy": {
    "selection": "thompson_sampling_over_capability_match",
    "fallback_cascade": true,
    "low_confidence_threshold": 0.55,
    "max_hops": 4,
    "timeout_ms": 25000,
    "always_log_to": "mesh-events"
  },
