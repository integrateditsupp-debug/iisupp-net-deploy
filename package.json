{
  "name": "iisupport-net",
  "version": "1.5.0",
  "private": true,
  "description": "Integrated IT Support — main site + ARIA AI helpdesk",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "kb:build": "node scripts/build-kb-index.mjs",
    "kb:test": "node scripts/test-kb-queries.mjs",
    "kb:recycle": "node scripts/kb-recycler-run.mjs",
    "kb:recycle:apply": "node scripts/kb-recycler-run.mjs --apply",
    "kb:recycle:test": "node tests/kb-recycler.test.mjs",
    "axis:once": "node scripts/axis-runner.mjs --once",
    "axis:drain": "node scripts/axis-runner.mjs",
    "axis:dry": "node scripts/axis-runner.mjs --dry-run",
    "axis:kill": "node -e \"require('fs').writeFileSync('senior-director-state/AXIS-RUNNER-KILL','halt '+new Date().toISOString())\"",
    "axis:unkill": "node -e \"try{require('fs').unlinkSync('senior-director-state/AXIS-RUNNER-KILL')}catch{}\"",
    "dev": "npx -y http-server -p 8765 -c-1 --silent",
    "dev:netlify": "netlify dev",
    "business-dev:once": "node scripts/business-development-agent.mjs",
    "opportunities:research": "node scripts/opportunity-research-agent.mjs",
    "opportunities:review": "node scripts/opportunity-review-agent.mjs",
    "opportunities:once": "node scripts/opportunity-research-agent.mjs && node scripts/opportunity-review-agent.mjs",
    "opportunities:install-worker": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-opportunity-engine-worker.ps1",
    "interaction-avoidance:once": "node scripts/interaction-avoidance-agent.mjs",
    "interaction-avoidance:install-worker": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-interaction-avoidance-agent-worker.ps1",
    "opportunities:prep": "node scripts/opportunity-prep-packets-agent.mjs",
    "opportunities:prep:install-worker": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-opportunity-prep-packets-worker.ps1",
    "opportunities:quality": "node scripts/opportunity-quality-gate-agent.mjs",
    "opportunities:quality:install-worker": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-opportunity-quality-gate-worker.ps1",
    "ceo-digest:once": "node scripts/ceo-action-digest-agent.mjs",
    "ceo-digest:install-worker": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-ceo-action-digest-worker.ps1",
    "ceo-console:once": "node scripts/ceo-action-console-agent.mjs",
    "ceo-console:serve": "node scripts/ceo-action-console-server.mjs",
    "ceo-console:proceed": "node scripts/ceo-action-console-proceed-agent.mjs",
    "ceo-console:route-notes": "node scripts/ceo-action-console-note-router.mjs",
    "contracts:bids:status": "node scripts/contracts-bids-status-agent.mjs",
    "contracts:bids:sync": "node scripts/contracts-bids-sync-agent.mjs",
    "contracts:bids:result": "node scripts/contracts-bids-submit-result-agent.mjs",
    "autonomy:once": "node scripts/autonomy-supervisor-agent.mjs",
    "cleanup:once": "node scripts/workspace-cleanup-agent.mjs",
    "site:hygiene": "node scripts/check-public-route-hygiene.mjs",
    "director:once": "node scripts/senior-director-worker.mjs --once",
    "director:worker": "node scripts/senior-director-worker.mjs",
    "youtube:generate": "node scripts/build-youtube-engine.mjs",
    "youtube:queue": "node scripts/youtube-production-agent.mjs",
    "sentinel:build": "npm --prefix apps/sentinel-desktop run build",
    "sentinel:test": "npm --prefix apps/sentinel-desktop test",
    "sentinel:prototype:test": "npm --prefix \"ARIA Sentinel\" test",
    "sentinel:public-pages:test": "node tests/sentinel/public-pages.spec.mjs",
    "aria:classifier:scenarios": "node tests/run-10k-scenarios.js",
    "aria:nlu:test": "node tests/classifier-tier23.test.mjs && node tests/topic-switch.test.mjs && node tests/low-confidence-escalation.test.mjs"
  },
  "dependencies": {
    "@netlify/blobs": "^7.4.0",
    "framer-motion": "^12.40.0",
    "nodemailer": "^9.0.1",
    "stripe": "^17.0.0"
  }
}
